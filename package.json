{
	"name": "tessera-plugin",
	"version": "1.0.0",
	"description": "Modular component library for DataviewJS - Build beautiful dashboards, cards, heatmaps, and more",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"dataview",
		"dataviewjs",
		"components",
		"dashboard",
		"card",
		"heatmap",
		"progressbar"
	],
	"author": "TesseraScript",
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"chart.js": "^4.5.1",
		"echarts": "^6.1.0",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
