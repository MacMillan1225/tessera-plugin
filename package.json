{
	"name": "tessera-plugin",
	"version": "1.25.0",
	"description": "基于 DataviewJS 的组件库插件 - 卡片、热力图、进度条与图表，快速搭建个人看板",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run"
	},
	"keywords": [
		"obsidian",
		"dataview",
		"dataviewjs",
		"components",
		"dashboard",
		"card",
		"heatmap",
		"progressbar",
		"chart",
		"echarts",
		"lieflat"
	],
	"author": "猫佑Millan",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"chart.js": "^4.5.1",
		"echarts": "^6.1.0",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"jsdom": "^29.1.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.11"
	}
}
